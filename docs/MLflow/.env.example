# Central MLflow endpoint.
MLFLOW_TRACKING_URI=https://mlflowhpi.mittelstand-zukunftslab.de

# Existing workspace and experiment names.
MLFLOW_DEV_WORKSPACE=dev-workspace
MLFLOW_TEST_WORKSPACE=test-workspace
MLFLOW_DEV_RAG_EXPERIMENT=target-rag
MLFLOW_DEV_SMOKE_TEST_EXPERIMENT=smoke-test
MLFLOW_DEV_HERMES_EXPERIMENT=hermes
MLFLOW_HIDDEN_EVAL_EXPERIMENT=target-rag-hidden-eval
MLFLOW_HIDDEN_SMOKE_TEST=smoke-test-hidden

# Separate central service identities and credentials.
MLFLOW_RAG_USERNAME=rag-service
MLFLOW_RAG_PASSWORD=replace-with-rag-service-password
MLFLOW_DEEPFIX_USERNAME=deepfix-reader
MLFLOW_DEEPFIX_PASSWORD=replace-with-deepfix-reader-password
MLFLOW_HERMES_USERNAME=hermes-service
MLFLOW_HERMES_PASSWORD=replace-with-hermes-service-password

# Shared evidence identifiers. Replace the corpus placeholder with its canonical ID.
# Increment baseline_NNN manually for each new baseline. Hermes will later supply candidate_NNN.
MLFLOW_CANDIDATE_ID=baseline_001
MLFLOW_CORPUS_ID=replace-with-canonical-corpus-id
