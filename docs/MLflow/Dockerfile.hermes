ARG HERMES_IMAGE=nousresearch/hermes-agent:latest
FROM ${HERMES_IMAGE}

ARG HERMES_OTEL_COMMIT=c76bea8434e6cc8b51c835bb57c514a5eb71e857

USER root

COPY pyproject.toml /tmp/deepfix-mlflow/pyproject.toml
COPY deepfix_mlflow/ /tmp/deepfix-mlflow/deepfix_mlflow/
RUN uv pip install \
      --python /opt/hermes/.venv/bin/python \
      /tmp/deepfix-mlflow \
    && rm -rf /tmp/deepfix-mlflow

RUN uv pip install \
      --python /opt/hermes/.venv/bin/python \
      "opentelemetry-api<2" \
      "opentelemetry-sdk<2" \
      "opentelemetry-exporter-otlp-proto-http<2" \
      pyyaml \
    && git clone https://github.com/briancaffey/hermes-otel.git /tmp/hermes-otel \
    && cd /tmp/hermes-otel \
    && git checkout --detach "${HERMES_OTEL_COMMIT}" \
    && test "$(git rev-parse HEAD)" = "${HERMES_OTEL_COMMIT}" \
    && mkdir -p /opt/hermes/plugins/hermes_otel \
    && cp -a hermes_otel/. /opt/hermes/plugins/hermes_otel/ \
    && rm -rf /tmp/hermes-otel

COPY start_hermes.py /opt/hermes-deploy/start_hermes.py
RUN chmod 0755 /opt/hermes-deploy/start_hermes.py

# Do not set USER hermes and do not replace the upstream ENTRYPOINT.
# The upstream image needs to start as root for its s6/stage2 initialization.
