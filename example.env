# ==============================================================================
# DeepFix RAG Environment Configuration Template
# Copy this file to .env and fill in your credentials and custom configurations:
#   cp example.env .env
# ==============================================================================

# ------------------------------------------------------------------------------
# MLflow Tracking & Experiment Configuration
# ------------------------------------------------------------------------------
# Every machine-to-machine caller uses this internal Compose name. MLflow is
# not published to the host and has no authentication, so it is reachable only
# from the Compose network. Point this at a public, authenticated domain only if
# you run one deliberately; the admin screen turns it into the "open run" link
# and hides that link when the value is an internal host.
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_DEV_RAG_EXPERIMENT=dev_rag_experiment
MLFLOW_ENABLE_ASYNC_TRACE_LOGGING=true
# This MLflow deployment does not require credentials or workspace headers.

# ------------------------------------------------------------------------------
# LLM Inference Configuration
# ------------------------------------------------------------------------------
# Every model id is deployment configuration. The code has no model default:
# `deepfix eval` and the judge exit with an error naming the variable when the
# value it needs is empty, and the Hermes sandbox refuses to boot without
# HERMES_MODEL. Keep the defaults here and in the Compose files.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Answer generation. Served by LLM_BASE_URL.
LLM_MODEL=qwen/qwen3.8-flash
# The Ask chat calls this same model with tools. If it ever stops advertising
# tool calling, the manual fallback is qwen/qwen3.8-27b, set here: there is no
# Ask-chat model variable, on purpose, so eval and the chat cannot diverge.
# DeepEval judge. It may differ from LLM_MODEL; a stronger or cheaper model is
# fine as long as it serves the same OpenAI-compatible endpoint and structured
# JSON. This one is an OpenRouter id.
LLM_JUDGE_MODEL=z-ai/glm-5.3-flash
# Drop sampling params the provider rejects. Claude Haiku 5.5 allows only temperature=1.
# Applies to answer generation, the judge, and eval. Default is on.
DEEPFIX_LLM_DROP_PARAMS=1

# S3-compatible storage. The RustFS service publishes no host port, so this is
# the Compose service name, and the value every container reads.
S3_ENDPOINT_URL=http://rustfs:9000
S3_URI=s3://deepfix-index/dev
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin

HF_TOKEN=

# ------------------------------------------------------------------------------
# Embedding Model Configuration
# ------------------------------------------------------------------------------
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=perplexity/pplx-embed-v1-4b

# ------------------------------------------------------------------------------
# Reranker Configuration (OpenRouter rerank API)
# ------------------------------------------------------------------------------
# Rerank posts to POST <COHERE_BASE_URL>/rerank. With the OpenRouter base below
# that is https://openrouter.ai/api/v1/rerank, authorized by OPENROUTER_API_KEY
# (set with the Hermes section below); backend-api receives that key for this
# call. COHERE_API_KEY is only a legacy fallback for it: the client reads
# OPENROUTER_API_KEY first and uses COHERE_API_KEY just when that is empty, and
# no native Cohere /v2/rerank path is called. Leave COHERE_BASE_URL at the
# OpenRouter OpenAI-compatible base; a host without a path resolves to
# /api/v1/rerank.
COHERE_BASE_URL=https://openrouter.ai/api/v1
COHERE_MODEL=cohere/rerank-4-fast

# ------------------------------------------------------------------------------
# Memgraph Graph Database
# ------------------------------------------------------------------------------
MEMGRAPH_URL=bolt://localhost:7687
MEMGRAPH_USERNAME=neo4j
MEMGRAPH_PASSWORD=neo4j

# ------------------------------------------------------------------------------
# FalkorDB Graph Database
# ------------------------------------------------------------------------------
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_DATABASE=my_knowledge_graph

# ------------------------------------------------------------------------------
# Hermes Agent (internal sandbox; no published port, dashboard off)
# ------------------------------------------------------------------------------
# Required by the Hermes image and by the API Hermes client, which sends it
# only as Authorization: Bearer to http://hermes:8642. At least 16 characters;
# placeholders are rejected. Generate with: openssl rand -hex 32
# The value is never written into the run prompt.
API_SERVER_KEY=
# Distinct from LLM_API_KEY. The Hermes service does not receive LLM_API_KEY.
# Also the bearer the backend-api rerank call uses.
OPENROUTER_API_KEY=
# Model the Hermes sandbox optimization agent runs. Written into
# /opt/data/config.yaml and posted on POST /v1/runs. Required: the sandbox
# fails to boot without it, and an empty value here fails compose start.
HERMES_MODEL=deepseek/deepseek-v4.1-flash-1017
# Provider segment Hermes routes through. OpenRouter unless you point
# HERMES_MODEL_BASE_URL at another endpoint.
# HERMES_MODEL_PROVIDER=openrouter
# Optional. A non-default OpenAI-compatible endpoint for the model above.
# HERMES_MODEL_BASE_URL=
# The same model id, read by `deepfix eval` inside that container when it
# scores generation metrics. It may differ from LLM_MODEL used by the API.
# LLM_MODEL=qwen/qwen3.8-flash
# LLM_JUDGE_MODEL=z-ai/glm-5.3-flash
# Optional. Stored only in the chat profile .env, never in the optimization one.
# The chat profile is a standalone gateway on 8643 that starts only when
# HERMES_CHAT_ENABLED=true. At least 16 characters; placeholders are rejected.
HERMES_CHAT_API_SERVER_KEY=
# Admin Hermes chat. Off by default: no chat gateway process and nothing
# listening on 8643. Set true to start the chat profile's standalone gateway.
HERMES_CHAT_ENABLED=false
# Optional. The chat profile's model. Unset or blank uses HERMES_MODEL above,
# so a default deploy runs one model. Point it elsewhere only on purpose.
# HERMES_CHAT_MODEL=
# Optional. Where deepfix-api reaches the chat profile on the Compose network.
# HERMES_CHAT_BASE_URL=http://hermes:8643
# The MLflow experiment chat turn traces go to. Separate from the optimizer's
# deepfix_hermes, so a bad answer can be read without the run history.
MLFLOW_HERMES_CHAT_EXPERIMENT=deepfix_hermes_chat
# Chat size limits. A request past either is a readable 400, not a stack trace.
ADMIN_CHAT_MAX_PROMPT_CHARS=48000
ADMIN_CHAT_MAX_MESSAGES=60
# Wall clock one reply may take before it is stopped and the turn marked failed.
ADMIN_CHAT_TURN_TIMEOUT_SECONDS=300
# Cap on the server-built status digest. Oldest runs are dropped first.
ADMIN_CHAT_DIGEST_MAX_CHARS=6000
# Turns one admin may start inside the window, and the window itself. The 31st
# is a 429 with Retry-After, and one admin may run one turn at a time.
ADMIN_CHAT_MAX_TURNS_PER_WINDOW=30
ADMIN_CHAT_TURN_WINDOW_SECONDS=300
# Turns across all admins at once. The container is 4 GB shared two gateways.
# One more is a 429 "The assistant is busy." with no audit row.
ADMIN_CHAT_MAX_CONCURRENT_TURNS=2
# How long a proposed action card stays confirmable.
ADMIN_CHAT_ACTION_TTL_SECONDS=600
# Lines of a run's step log the thread's run panel shows, and the most bytes the
# reader takes to get them (it seeks to the end; a 10 MB log is never loaded
# whole). The `----- output -----` section is never part of the tail.
ADMIN_CHAT_STEP_TAIL=50
ADMIN_CHAT_STEP_READ_BYTES=65536
# Audit rows are kept this many days and pruned hourly by the API. 0 (or a
# negative value) keeps them forever. A thread delete never removes one.
ADMIN_CHAT_AUDIT_RETENTION_DAYS=14

# Ask chat bounds. Members outnumber admins and share one API process, so these
# are smaller than the admin chat's. The first two are a member's own budget: the
# 21st question inside 300 s is a 429 with Retry-After. The third is global across
# the deployment: one more turn than this is a 429 "busy", not the member's fault.
ASK_CHAT_MAX_TURNS_PER_WINDOW=20
ASK_CHAT_TURN_WINDOW_SECONDS=300
ASK_CHAT_MAX_CONCURRENT_TURNS=4
# Model steps a turn may take a tool call on: at most four model steps, and the
# last one is forced to prose so the loop always ends.
ASK_CHAT_MAX_TOOL_CALLS=3
# Stored messages from earlier turns sent as context: six exchanges.
ASK_CHAT_MAX_HISTORY_MESSAGES=12
# A question, not a document. A longer message is a 400 naming the limit.
ASK_CHAT_MAX_MESSAGE_CHARS=4000
# One passage as sent to the model. The stored hit keeps the full text, because
# `passage_key` hashes it and the optimizer groups on that hash.
ASK_CHAT_MAX_PASSAGE_CHARS=1200
# Wall clock one answer may take before it is stopped and the turn marked failed.
ASK_CHAT_TURN_TIMEOUT_SECONDS=120
# How much the model may think before it answers: off, low, medium, high.
# "off" is the default. A reasoning model at its provider default can spend the
# whole output budget on hidden thinking and stream no prose for minutes, which
# looks to a member like a hung page (and a Cloudflare-proxied response with no
# bytes for 100 s is dropped). Raise it only if a deployment wants the reasoning.
ASK_CHAT_REASONING=off
# How much a step that may call search_documents may think. "low" is measured:
# with thinking off, the model tended to refuse or introduce itself before calling
# the tool; "low" called it cleanly in six of six runs. The answer step keeps
# ASK_CHAT_REASONING above, because reasoning there only delays the first word.
ASK_CHAT_TOOL_STEP_REASONING=low
# Most tokens one step may produce, reasoning included. An uncapped reasoning
# step can spend the entire budget before it writes a visible character.
ASK_CHAT_MAX_OUTPUT_TOKENS=2048
# IAM user hermes-optimizer. The policy allows only optimization/runs/* on the
# bucket in S3_URI. This is not the root key (S3_ACCESS_KEY_ID / RUSTFS_ACCESS_KEY).
# The API keeps the root key and uses it to write the run bundle.
HERMES_S3_ACCESS_KEY_ID=
HERMES_S3_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# MLflow Server (docker compose)
# The tracking client above still uses MLFLOW_TRACKING_URI.
# The service publishes no host port. A human reaches the UI through the two
# Traefik routers docker-compose.yml declares for it (http redirects, https
# requires basic auth); everything else (backend-api, hermes, diagnostic-agent)
# stays on mlflow:5000 inside the Compose network. See "MLflow and RustFS
# lockdown" in README.md.
# ------------------------------------------------------------------------------
MLFLOW_BACKEND_STORE_URI=sqlite:////opt/mlflow/data/mlflow.db
# The host the Traefik routers match. Empty keeps the compose default
# `deepfix-mlflow.invalid`, which matches no request, so the UI does not open
# until the host is set. The host must also appear in
# MLFLOW_SERVER_ALLOWED_HOSTS below, or MLflow rejects the proxied request
# before the UI loads.
# MLFLOW_PUBLIC_HOST=mlflow.example.com
# The basic-auth user list for the `deepfix-mlflow-auth` middleware: one or
# more `user:bcrypt-hash` entries, comma-separated with no space between them.
# Generate it with every `$` doubled for this file's interpolation:
#   htpasswd -nbB admin 'pass' | sed -e 's/\$/\$\$/g'
# Doubling is required, not optional. On the server's docker-compose v1 the
# value from .env IS re-interpolated, so a single-`$` bcrypt hash is corrupted
# and every login fails. Doubling is also required in Dokploy's Environment
# tab, which writes that value into the same .env. The doubled form resolves to
# the original hash in the container's label, which is what Traefik compares.
# Empty fails closed: the UI does not open.
# This is a credential. Never commit a real value.
MLFLOW_BASIC_AUTH_USERS=
# Optional. Unset values use the defaults in docker-compose.yml.
# MLflow 3.x matches Host exactly, so list hostname and hostname:port separately.
# CORS origins are full scheme://host[:port] strings.
# The public domain's Host must be here, or the middleware-proxied request is
# rejected before it reaches the UI.
MLFLOW_SERVER_ALLOWED_HOSTS=hermes,localhost,diagnostic-agent,mlflow,mlflow:5000,localhost:5000,127.0.0.1,127.0.0.1:5000,backend-api,deepfix-mlflow.mittelstand-zukunftslab.de
MLFLOW_SERVER_CORS_ALLOWED_ORIGINS=http://hermes,http://localhost,http://diagnostic-agent,http://mlflow:5000,http://backend-api:8000,https://deepfix-mlflow.mittelstand-zukunftslab.de

# ------------------------------------------------------------------------------
# RustFS (docker compose)
# The S3 API and the console publish no host port. The console has no consumer
# here and is the only full-control surface without an IAM policy in front of
# it, so it stays off. Flip it to true only on a private network and rebuild the
# rustfs service alone. See "MLflow and RustFS lockdown" in README.md.
# ------------------------------------------------------------------------------
RUSTFS_CONSOLE_ENABLE=false

# ------------------------------------------------------------------------------
# DeepFix Analysis Server (docker compose)
# Point DEEPFIX_SERVER_URL to http://localhost:8844 when using local server.
# ------------------------------------------------------------------------------
DEEPFIX_SERVER_URL=http://diagnostic-agent:8844
DEEPFIX_LLM_API_KEY=
DEEPFIX_LLM_BASE_URL=https://openrouter.ai/api/v1
DEEPFIX_LLM_MODEL_NAME=openai/gpt-6-luna-pro
DEEPFIX_LLM_TEMPERATURE=0.7
DEEPFIX_LLM_MAX_TOKENS=8000
DEEPFIX_LLM_CACHE=1
DEEPFIX_LLM_TRACK_USAGE=1
# The diagnostic server reads LiteLLM's own flag. Compose sets it from DEEPFIX_LLM_DROP_PARAMS.
LITELLM_DROP_PARAMS=1
DEEPFIX_SEARCH_PROVIDER=duckduckgo
NUM_REASONING_CHAINS=1
DEEPFIX_SERVER_DATABASE_URL=sqlite:////root/.deepfix/deepfix_server.db
MLFLOW_EXP_NAME=Deepfix-diagnostic-agent

# ------------------------------------------------------------------------------
# Product API (FastAPI)
# ------------------------------------------------------------------------------
# Console log level for the API container (docker logs backend-api). The
# deepfix_rag and apscheduler loggers print to stdout at this level: scheduled
# optimization runs, their outcome, and APScheduler misfires. One of DEBUG,
# INFO, WARNING, ERROR, CRITICAL. Default INFO; an unknown value warns and
# falls back to INFO. The value itself is never logged.
DEEPFIX_LOG_LEVEL=INFO
# The public host each Traefik router matches. The compose file is the only
# source of routing: these two names replace the Dokploy Domain entries, which
# must be deleted, or two routers claim the same host. An empty value keeps the
# fail-closed `*.invalid` default in docker-compose.yml, so the site does not
# answer until the host is set. Hostnames only: no scheme, no path.
DEEPFIX_WEB_HOST=deepfix.mittelstand-zukunftslab.de
DEEPFIX_API_HOST=deepfix-api.mittelstand.zukunftslab.de
# Origin of the web app (the Vite dev server listens on 8080). Accounts live in the web app
# (Better Auth); FastAPI only verifies the identity token it attaches. WEB_ORIGIN must equal
# BETTER_AUTH_URL in web/.env.local: it is the token issuer and audience, and the default
# key set URL is WEB_ORIGIN/api/auth/jwks.
# In a deployment this is https:// plus DEEPFIX_WEB_HOST, not the container port.
WEB_ORIGIN=http://localhost:8080
# The API container fetches Better Auth's public keys from the web service.
# Issuer and audience stay WEB_ORIGIN above.
# AUTH_JWKS_URL=http://web:8080/api/auth/jwks
# Web container (compose service `web`). BETTER_AUTH_URL inside the container is WEB_ORIGIN.
# Generate a secret with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# FastAPI as seen from the web container. Default is the compose service `backend-api`.
# API_INTERNAL_URL=http://backend-api:8000
# Comma-separated domains allowed to register. Empty means anyone can register.
# ALLOWED_EMAIL_DOMAINS=
# Hermes is the only optimization agent. The API submits runs to HERMES_BASE_URL
# and still scores holdout and promotes. API_SERVER_KEY above is the bearer token
# the API sends to Hermes. Leave this unset unless you run Hermes elsewhere.
# HERMES_BASE_URL=http://hermes:8642
OPTIMIZATION_MIN_DEV_QUESTIONS=50
OPTIMIZATION_MIN_NEW_DEV_QUESTIONS=10
OPTIMIZATION_MIN_HOLDOUT_QUESTIONS=15
OPTIMIZATION_MIN_PRIMARY_DELTA=0.025
# Secondary metrics may fall this far without failing the gate or the promotion check.
OPTIMIZATION_SECONDARY_TOLERANCE=-0.01
OPTIMIZATION_RUN_TIMEOUT_HOURS=3
# No Hermes event (other than SSE keepalive) and no fresh output/heartbeat.json
# for this many minutes fails the row. The default is 5.
OPTIMIZATION_HEARTBEAT_STALL_MINUTES=5
