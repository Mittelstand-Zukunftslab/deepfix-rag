# ==============================================================================
# DeepFix RAG Environment Configuration Template
# Copy this file to .env and fill in your credentials and custom configurations:
#   cp example.env .env
# ==============================================================================

# ------------------------------------------------------------------------------
# MLflow Tracking & Experiment Configuration
# ------------------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_DEV_RAG_EXPERIMENT=dev_rag_experiment
MLFLOW_ENABLE_ASYNC_TRACE_LOGGING=true
# Agent OTLP tracing: use the numeric ID of an existing MLflow experiment.
MLFLOW_OTLP_ENDPOINT=http://mlflow:5000/v1/traces
MLFLOW_EXPERIMENT_ID=0
# This MLflow deployment does not require credentials or workspace headers.

# ------------------------------------------------------------------------------
# LLM Inference Configuration
# ------------------------------------------------------------------------------
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=anthropic/claude-haiku-5.5
LLM_JUDGE_MODEL=openai/gpt-5.6-luna
# Drop sampling params the provider rejects. Claude Haiku 5.5 allows only temperature=1.
# Applies to answer generation, the judge, eval, and the OpenHands child. Default is on.
DEEPFIX_LLM_DROP_PARAMS=1

# S3-compatible storage
S3_ENDPOINT_URL=http://rustfs:9000
S3_URI=s3://deepfix-index/dev
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin

HF_TOKEN=

# ------------------------------------------------------------------------------
# Embedding Model Configuration
# ------------------------------------------------------------------------------
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=perplexity/pplx-embed-v1-4b

# ------------------------------------------------------------------------------
# Reranker Configuration (Cohere-compatible API)
# ------------------------------------------------------------------------------
COHERE_BASE_URL=https://openrouter.ai/api/v1
COHERE_API_KEY=
COHERE_MODEL=cohere/rerank-4-fast

# ------------------------------------------------------------------------------
# Memgraph Graph Database
# ------------------------------------------------------------------------------
MEMGRAPH_URL=bolt://localhost:7687
MEMGRAPH_USERNAME=neo4j
MEMGRAPH_PASSWORD=neo4j

# ------------------------------------------------------------------------------
# FalkorDB Graph Database
# ------------------------------------------------------------------------------
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_DATABASE=my_knowledge_graph

# ------------------------------------------------------------------------------
# Hermes Agent (internal sandbox; no published port, dashboard off)
# ------------------------------------------------------------------------------
# Required by the Hermes image. At least 16 characters; placeholders are
# rejected. Generate with: openssl rand -hex 32
API_SERVER_KEY=
# Distinct from LLM_API_KEY. The Hermes service does not receive LLM_API_KEY.
OPENROUTER_API_KEY=
# Optional. Stored only in the chat profile .env. That profile is not started.
HERMES_CHAT_API_SERVER_KEY=
# IAM user hermes-optimizer. The policy allows only optimization/runs/* on the
# bucket in S3_URI. This is not the root key (S3_ACCESS_KEY_ID / RUSTFS_ACCESS_KEY).
# The API keeps the root key and uses it to write the run bundle.
HERMES_S3_ACCESS_KEY_ID=
HERMES_S3_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# MLflow Server (docker compose)
# The tracking client above still uses MLFLOW_TRACKING_URI.
# Point that URI at http://localhost:5000 to use this local server.
# ------------------------------------------------------------------------------
MLFLOW_BACKEND_STORE_URI=sqlite:////opt/mlflow/data/mlflow.db
MLFLOW_ALLOWED_HOSTS=localhost,127.0.0.1,mlflow
MLFLOW_CORS_ALLOWED_ORIGINS=http://mlflow:5000
# Optional. Unset values use the defaults in docker-compose.yml.
# MLflow 3.x matches Host exactly, so list hostname and hostname:port separately.
# CORS origins are full scheme://host[:port] strings.
MLFLOW_SERVER_ALLOWED_HOSTS=hermes,openhands,localhost,diagnostic-agent,mlflow,mlflow:5000,localhost:5000,127.0.0.1,127.0.0.1:5000,backend-api,deepfix-mlflow.mittelstand-zukunftslab.de
MLFLOW_SERVER_CORS_ALLOWED_ORIGINS=http://hermes,http://openhands,http://localhost,http://diagnostic-agent,http://mlflow:5000,http://backend-api:8000,https://deepfix-mlflow.mittelstand-zukunftslab.de

# ------------------------------------------------------------------------------
# DeepFix Analysis Server (docker compose)
# Point DEEPFIX_SERVER_URL to http://localhost:8844 when using local server.
# ------------------------------------------------------------------------------
DEEPFIX_SERVER_URL=http://diagnostic-agent:8844
DEEPFIX_LLM_API_KEY=
DEEPFIX_LLM_BASE_URL=https://openrouter.ai/api/v1
DEEPFIX_LLM_MODEL_NAME=openai/gpt-6-luna-pro
DEEPFIX_LLM_TEMPERATURE=0.7
DEEPFIX_LLM_MAX_TOKENS=8000
DEEPFIX_LLM_CACHE=1
DEEPFIX_LLM_TRACK_USAGE=1
# The diagnostic server reads LiteLLM's own flag. Compose sets it from DEEPFIX_LLM_DROP_PARAMS.
LITELLM_DROP_PARAMS=1
DEEPFIX_SEARCH_PROVIDER=duckduckgo
NUM_REASONING_CHAINS=1
DEEPFIX_SERVER_DATABASE_URL=sqlite:////root/.deepfix/deepfix_server.db
MLFLOW_EXP_NAME=Deepfix-diagnostic-agent

# ------------------------------------------------------------------------------
# Product API (FastAPI)
# ------------------------------------------------------------------------------
# Origin of the web app (the Vite dev server listens on 8080). Accounts live in the web app
# (Better Auth); FastAPI only verifies the identity token it attaches. WEB_ORIGIN must equal
# BETTER_AUTH_URL in web/.env.local: it is the token issuer and audience, and the default
# key set URL is WEB_ORIGIN/api/auth/jwks.
WEB_ORIGIN=http://localhost:8080
# The API container fetches Better Auth's public keys from the web service.
# Issuer and audience stay WEB_ORIGIN above.
# AUTH_JWKS_URL=http://web:8080/api/auth/jwks
# Web container (compose service `web`). BETTER_AUTH_URL inside the container is WEB_ORIGIN.
# Generate a secret with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# FastAPI as seen from the web container. Default is the compose service `backend-api`.
# API_INTERNAL_URL=http://backend-api:8000
# Comma-separated domains allowed to register. Empty means anyone can register.
# ALLOWED_EMAIL_DOMAINS=
# OpenRouter key for the OpenHands child process. The product LLM_API_KEY is not passed through.
# DEEPFIX_LLM_API_KEY=
# DEEPFIX_LLM_BASE_URL=https://openrouter.ai/api/v1
# DEEPFIX_LLM_MODEL_NAME=openai/gpt-6-luna-pro
# Interpreter of the dedicated OpenHands virtual environment. See tasks/notes-openhands-integration.md.
# OPENHANDS_PYTHON=
OH_SESSION_HOST=http://openhands:8000
OPTIMIZATION_MIN_DEV_QUESTIONS=50
OPTIMIZATION_MIN_NEW_DEV_QUESTIONS=10
OPTIMIZATION_MIN_HOLDOUT_QUESTIONS=15
OPTIMIZATION_MIN_PRIMARY_DELTA=0.025
# Secondary metrics may fall this far without failing the gate or the promotion check.
OPTIMIZATION_SECONDARY_TOLERANCE=-0.01
OPTIMIZATION_RUN_TIMEOUT_HOURS=3
# Judge rounds of the OpenHands goal completion loop per run.
OPTIMIZATION_GOAL_ROUNDS=3
