# Copy to .env.local. Browser settings are read only through src/lib/config.ts; server settings
# only through src/lib/server-config.ts.
VITE_API_BASE_URL=http://localhost:8000

# FastAPI, called only by this web server.
API_INTERNAL_URL=http://127.0.0.1:8000

# Better Auth. Generate a secret with `openssl rand -base64 32`.
# BETTER_AUTH_URL must match WEB_ORIGIN in the repo .env: FastAPI checks it as the token issuer.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080
# SQLite file for users and sessions. Defaults to ~/.deepfix/web/auth.db.
# AUTH_DATABASE_PATH=
# Comma-separated domains allowed to register. Empty means anyone can register.
ALLOWED_EMAIL_DOMAINS=
