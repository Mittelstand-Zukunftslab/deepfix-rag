            },
            "title": "Answer Approval By Config",
            "type": "array"
          },
          "answer_approval_rate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Answer Approval Rate"
          },
          "answer_down": {
            "title": "Answer Down",
            "type": "integer"
          },
          "answer_up": {
            "title": "Answer Up",
            "type": "integer"
          },
          "dev_question_count": {
            "title": "Dev Question Count",
            "type": "integer"
          },
          "feedback_experiment_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Feedback Experiment Url"
          },
          "holdout_question_count": {
            "title": "Holdout Question Count",
            "type": "integer"
          },
          "no_trace_event_count": {
            "title": "No Trace Event Count",
            "type": "integer"
          },
          "passage_down": {
            "title": "Passage Down",
            "type": "integer"
          },
          "passage_up": {
            "title": "Passage Up",
            "type": "integer"
          },
          "product_experiment_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Product Experiment Url"
          },
          "unsynced_event_count": {
            "title": "Unsynced Event Count",
            "type": "integer"
          }
        },
        "required": [
          "passage_up",
          "passage_down",
          "answer_up",
          "answer_down",
          "dev_question_count",
          "holdout_question_count",
          "answer_approval_rate",
          "answer_approval_by_config",
          "unsynced_event_count",
          "no_trace_event_count",
          "product_experiment_url",
          "feedback_experiment_url"
        ],
        "title": "FeedbackSummaryResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Liveness probe payload.",
