{
  "components": {
    "schemas": {
      "AskResponse": {
        "description": "One single-turn answer and the passages it used.",
        "properties": {
          "answer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Answer"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "hits": {
            "items": {
              "$ref": "#/components/schemas/HitResponse"
            },
            "title": "Hits",
            "type": "array"
          },
          "interaction_id": {
            "title": "Interaction Id",
            "type": "string"
          },
          "vote": {
            "anyOf": [
              {
                "enum": [
                  "up",
                  "down"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Vote"
          }
        },
        "required": [
          "interaction_id",
          "answer",
          "error",
          "vote",
          "hits"
        ],
        "title": "AskResponse",
        "type": "object"
      },
      "Body_create_document": {
        "properties": {
          "file": {
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "type": "string"
          },
          "reading": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reading"
          }
        },
        "required": [
          "file"
        ],
        "title": "Body_create_document",
        "type": "object"
      },
      "ConfigApprovalResponse": {
        "description": "Answer approval for the interactions that used one champion config.",
        "properties": {
          "config_path": {
            "title": "Config Path",
            "type": "string"
          },
          "down": {
            "title": "Down",
            "type": "integer"
          },
          "rate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rate"
          },
          "up": {
            "title": "Up",
            "type": "integer"
          }
        },
        "required": [
          "config_path",
          "up",
          "down",
          "rate"
        ],
        "title": "ConfigApprovalResponse",
        "type": "object"
      },
      "CredentialsRequest": {
        "description": "Email and password for register and login.",
        "properties": {
          "email": {
            "minLength": 1,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "CredentialsRequest",
        "type": "object"
      },
      "DocumentResponse": {
        "description": "A non-deleted workspace document. Extracted text stays on disk.",
        "properties": {
          "can_delete": {
            "title": "Can Delete",
            "type": "boolean"
          },
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "doc_id": {
            "title": "Doc Id",
            "type": "string"
          },
          "filename": {
            "title": "Filename",
            "type": "string"
          },
          "index_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Index Error"
          },
          "issues": {
            "items": {
              "$ref": "#/components/schemas/TextIssueResponse"
            },
            "title": "Issues",
            "type": "array"
          },
          "media_type": {
            "title": "Media Type",
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "indexing",
              "indexed",
              "deleting",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          },
          "uploader_email": {
            "title": "Uploader Email",
            "type": "string"
          }
        },
        "required": [
          "doc_id",
          "filename",
          "media_type",
          "status",
          "index_error",
          "issues",
          "uploader_email",
          "created_at",
          "can_delete"
        ],
        "title": "DocumentResponse",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Body returned for every 4xx and 5xx response.",
        "properties": {
          "detail": {
            "description": "Human-readable explanation of what went wrong.",
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "FeedbackRequest": {
        "description": "A thumbs-up, thumbs-down, or clear on a passage or an answer.",
        "properties": {
          "action": {
            "enum": [
              "up",
              "down",
              "clear"
            ],
            "title": "Action",
            "type": "string"
          },
          "interaction_id": {
            "minLength": 1,
            "title": "Interaction Id",
            "type": "string"
          },
          "rank": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rank"
          },
          "target": {
            "enum": [
              "passage",
              "answer"
            ],
            "title": "Target",
            "type": "string"
          }
        },
        "required": [
          "interaction_id",
          "target",
          "action"
        ],
        "title": "FeedbackRequest",
        "type": "object"
      },
      "FeedbackResponse": {
        "description": "The user's current vote after the event was stored.",
        "properties": {
          "interaction_id": {
            "title": "Interaction Id",
            "type": "string"
          },
          "rank": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rank"
          },
          "target": {
            "enum": [
              "passage",
              "answer"
            ],
            "title": "Target",
            "type": "string"
          },
          "vote": {
            "anyOf": [
              {
                "enum": [
                  "up",
                  "down"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Vote"
          }
        },
        "required": [
          "interaction_id",
          "target",
          "rank",
          "vote"
        ],
        "title": "FeedbackResponse",
        "type": "object"
      },
      "FeedbackSummaryResponse": {
        "description": "Vote, dataset, and outbox counts for an admin.",
        "properties": {
          "answer_approval_by_config": {
            "items": {
