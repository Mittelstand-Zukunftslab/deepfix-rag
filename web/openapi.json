              "ready_with_errors",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          },
          "updated_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          }
        },
        "required": [
          "status",
          "document_count",
          "chunk_count",
          "pending_document_count",
          "updated_at",
          "config_path",
          "serving_build_id",
          "error"
        ],
        "title": "IndexStatusResponse",
        "type": "object"
      },
      "InteractionResponse": {
        "description": "A stored search or ask, including the current user's votes.",
        "properties": {
          "answer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Answer"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "hits": {
            "items": {
              "$ref": "#/components/schemas/HitResponse"
            },
            "title": "Hits",
            "type": "array"
          },
          "interaction_id": {
            "title": "Interaction Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "retrieval",
              "ask"
            ],
            "title": "Kind",
            "type": "string"
          },
          "query": {
            "title": "Query",
            "type": "string"
          },
          "vote": {
            "anyOf": [
              {
                "enum": [
                  "up",
                  "down"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Vote"
          }
        },
        "required": [
          "interaction_id",
          "kind",
          "query",
          "answer",
          "error",
          "vote",
          "hits"
        ],
        "title": "InteractionResponse",
        "type": "object"
      },
      "LogoutResponse": {
        "description": "Confirmation that the session cookie was cleared.",
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "LogoutResponse",
        "type": "object"
      },
      "OptimizationRunResponse": {
        "description": "The run recorded by a start request. Holdout questions are not included.",
