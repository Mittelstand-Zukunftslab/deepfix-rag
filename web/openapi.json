            "type": "integer"
          },
          "score": {
            "title": "Score",
            "type": "number"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "vote": {
            "anyOf": [
              {
                "enum": [
                  "up",
                  "down"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Vote"
          }
        },
        "required": [
          "rank",
          "doc_id",
          "document_filename",
          "text",
          "score",
          "vote"
        ],
        "title": "HitResponse",
        "type": "object"
      },
      "IndexStatusResponse": {
        "description": "Overall state of the shared serving index.",
        "properties": {
          "chunk_count": {
            "title": "Chunk Count",
            "type": "integer"
          },
          "config_path": {
            "title": "Config Path",
            "type": "string"
          },
          "document_count": {
            "title": "Document Count",
            "type": "integer"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "pending_document_count": {
            "title": "Pending Document Count",
            "type": "integer"
          },
          "serving_build_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Serving Build Id"
          },
          "status": {
            "enum": [
              "empty",
              "updating",
              "rebuilding",
