            "title": "Dev Count",
            "type": "integer"
          },
          "ended_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ended At"
          },
          "holdout_count": {
            "title": "Holdout Count",
            "type": "integer"
          },
          "new_dev_count": {
            "title": "New Dev Count",
            "type": "integer"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "started_at": {
            "title": "Started At",
            "type": "string"
          },
          "status": {
            "enum": [
              "running",
              "skipped",
              "rejected",
              "promoted",
              "succeeded",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          },
          "trigger": {
            "enum": [
              "cron",
              "manual"
            ],
            "title": "Trigger",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "status",
          "trigger",
          "reason",
          "dev_count",
          "new_dev_count",
          "holdout_count",
          "started_at",
          "ended_at"
        ],
        "title": "OptimizationRunResponse",
        "type": "object"
      },
      "QueryRequest": {
        "description": "A search or ask question.",
        "properties": {
          "query": {
            "minLength": 1,
            "title": "Query",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "title": "QueryRequest",
        "type": "object"
      },
      "RetrievalResponse": {
