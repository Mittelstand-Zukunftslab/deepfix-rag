        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "HTTP boundary around the DeepFix domain layer.",
    "title": "DeepFix Product API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/admin/feedback/summary": {
      "get": {
        "description": "Return vote, dataset, and outbox counts. Members receive 403.",
        "operationId": "get_feedback_summary",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedbackSummaryResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No valid session."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The signed-in user's role does not allow this action."
          }
        },
        "summary": "Summarize feedback",
        "tags": [
          "feedback"
        ]
      }
    },
    "/admin/index/rebuild": {
      "post": {
        "description": "Start a full repair rebuild. The current index keeps serving until it succeeds.",
        "operationId": "rebuild_index",
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndexStatusResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid input."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No valid session."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The signed-in user's role does not allow this action."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The request conflicts with the current state."
          }
        },
        "summary": "Rebuild the index",
        "tags": [
          "index"
        ]
      }
    },
    "/admin/optimization/run": {
      "post": {
        "description": "Export feedback and start one run, or skip it when too little is labeled.",
        "operationId": "start_optimization_run",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartOptimizationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OptimizationRunResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No valid session."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The signed-in user's role does not allow this action."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The request conflicts with the current state."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "A required dependency is not ready."
          }
        },
        "summary": "Start the optimization job now",
        "tags": [
          "optimization"
        ]
      }
    },
    "/admin/users/{user_id}": {
      "patch": {
        "description": "Promote or demote an account. Members receive 403. The last admin cannot be demoted.",
        "operationId": "update_user_role",
        "parameters": [
          {
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": {
              "title": "User Id",
