            "type": "string"
          }
        },
        "required": [
          "interaction_id",
          "hits"
        ],
        "title": "RetrievalResponse",
        "type": "object"
      },
      "RoleUpdateRequest": {
        "description": "New role for an existing account.",
        "properties": {
          "role": {
            "enum": [
              "member",
              "admin"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role"
        ],
        "title": "RoleUpdateRequest",
        "type": "object"
      },
      "StartOptimizationRequest": {
        "description": "Start the optimization job now. The nightly schedule calls the same function.",
        "properties": {},
        "title": "StartOptimizationRequest",
        "type": "object"
      },
      "TextIssueResponse": {
        "description": "A PDF page flagged as scanned or garbled. OCR is not run.",
        "properties": {
          "kind": {
            "enum": [
              "scanned",
              "garbled"
            ],
            "title": "Kind",
            "type": "string"
          },
          "page": {
            "title": "Page",
            "type": "integer"
          }
        },
        "required": [
          "page",
          "kind"
        ],
        "title": "TextIssueResponse",
        "type": "object"
      },
      "UserResponse": {
        "description": "A signed-in account. The password hash is never included.",
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "role": {
            "enum": [
              "member",
              "admin"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "role"
        ],
        "title": "UserResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
